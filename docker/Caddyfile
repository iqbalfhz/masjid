{
	# Matikan halaman admin Caddy: tidak dipakai, dan menutupnya mengurangi
	# permukaan yang terbuka di dalam jaringan container.
	admin off

	frankenphp

	# `php_server` harus dievaluasi sebelum `file_server` agar permintaan ke
	# rute Laravel tidak keburu dijawab sebagai berkas statis yang tidak ada.
	order php_server before file_server
}

# SERVER_NAME diisi ":80" lewat Dockerfile, sehingga Caddy melayani HTTP biasa
# tanpa mencoba menerbitkan sertifikat sendiri — TLS adalah urusan proxy Coolify
# di depannya. Bila image ini dipakai tanpa proxy, isi SERVER_NAME dengan nama
# domain untuk mengaktifkan HTTPS otomatis.
{$SERVER_NAME:":80"} {
	root /app/public
	encode zstd br gzip

	# Tidak ada penolak berkas titik di sini, dan itu disengaja.
	#
	# Yang melindungi `.env` adalah letaknya: ia berada di /app, sementara yang
	# dilayani hanya /app/public — Caddy secara struktural tidak bisa
	# menjangkaunya. Satu-satunya berkas titik di dalam docroot adalah
	# `.htaccess`, yang tidak dipakai Caddy dan tidak memuat rahasia.
	#
	# Versi sebelumnya memasang matcher untuk itu dan justru menjatuhkan
	# container: polanya memakai negative lookahead gaya Nginx, sedangkan Caddy
	# memakai RE2 milik Go yang tidak mendukungnya. Aturan dengan manfaat nol
	# tapi risiko nyata lebih baik tidak ada.

	# `php_server` sudah menangani pola front controller Laravel secara bawaan:
	# berkas statis dilayani apa adanya, sisanya diteruskan ke index.php.
	# Sengaja dibiarkan polos tanpa subdirektif — ia tidak menerima `try_files`,
	# dan konfigurasi minimal inilah yang dicontohkan dokumentasi FrankenPHP.
	php_server
}
